# 企業アカウント一覧 (JSON配列)
DTAKO_ACCOUNTS='[{"comp_id":"27324455","user_name":"autoload","user_pass":"2007","tenant_id":"TENANT_UUID_1"},{"comp_id":"75700192","user_name":"3","user_pass":"3","tenant_id":"TENANT_UUID_2"}]'

# auth-worker URL (device token 発行 + /device-data-proxy 経由で rust-alc-api に到達)
AUTH_WORKER_URL=https://auth.ippoan.org

# rust-alc-api への device credential (tenant_id -> {device_id, device_secret})。
# `.github/workflows/provision-device.yml` (workflow_dispatch) が tenant_id ごとに
# 発行して VPS の .env に自動投入する。手動編集は非推奨 (secret 漏洩注意)。
DTAKO_DEVICE_CREDENTIALS={"TENANT_UUID_1":{"device_id":"...","device_secret":"..."},"TENANT_UUID_2":{"device_id":"...","device_secret":"..."}}

# ダウンロードディレクトリ
DOWNLOAD_DIR=/tmp/dtako-downloads

# サーバーポート
PORT=8080

# ログレベル
RUST_LOG=dtako_scraper=info
